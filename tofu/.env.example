# Copy to tofu/.env (gitignored) and fill. Load before tofu:  set -a; . ./.env; set +a
# .env is NEVER committed.

# Hetzner Cloud API token. Also the ONLY thing ./scripts/dr.sh ips needs to resolve node
# public IPs (they are not in this repo) -- back it up separately, it is the break-glass path.
export TF_VAR_hcloud_token=

# Remote tfstate on Hetzner S3. Backends cannot read var.*, so the SAME credential must also
# be exported under these AWS_ names or `tofu init` fails. Rotating the key means changing
# both these and the TF_VAR_s3_* pair below.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=

# Same Hetzner S3 credential again, for the storage module (bucket mgmt) and for the rclone
# pull of the OpenBao snapshot in `dr.sh restore`.
export TF_VAR_s3_access_key=
export TF_VAR_s3_secret_key=

# k3s cluster join token (node1 /var/lib/rancher/k3s/server/token); also in OpenBao at
# secret/cluster.k3s_join_token. Empty only when bootstrapping the first node from scratch.
export TF_VAR_k3s_token=

# CIDR allowed to reach ssh + kube-api :6443
export TF_VAR_operator_cidr=

export TF_VAR_ssh_public_key=

# Optional, have defaults: location=nbg1, node_type=cx43, k3s_version="" (stable channel).
# Fleet is currently uniform cx33 across fsn1/hel1/nbg1.
# export TF_VAR_location=
# export TF_VAR_node_type=
# export TF_VAR_k3s_version=
