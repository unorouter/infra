{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly dependency bumps, never a PR. Patch and minor of images and charts merge straight to main in the Monday window (no CI here, ArgoCD rolls the commit). Everything else waits in the Dependency dashboard issue; ticking its box merges it to main on the next run.",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "ignoreTests": true,
  "automerge": true,
  "automergeType": "branch",
  "automergeSchedule": [
    "at any time"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency dashboard",
  "dependencyDashboardApproval": true,
  "minimumReleaseAge": "7 days",
  "pinDigests": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "docker": {
    "pinDigests": false
  },
  "argocd": {
    "managerFilePatterns": [
      "/^apps/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^(infra|databases)/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^infra/.+/values.*\\.yaml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/^tofu/.+\\.tf$/"
    ]
  },
  "packageRules": [
    {
      "description": "Noise: git branch sources, apiVersion bumps, the tofu binary constraint, the whoami digest",
      "matchDatasources": [
        "git-tags",
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "hashicorp/terraform",
        "traefik/whoami"
      ],
      "enabled": false
    },
    {
      "description": "Images: patch and minor merge on schedule",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/openbao\\/openbao$/",
        "!ghcr.io/cloudnative-pg/postgresql"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Charts that roll without an operator step: patch and minor merge on schedule",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "loki",
        "vector",
        "kube-prometheus-stack",
        "external-secrets",
        "velero"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Operators from release manifests: patch merges, minor and major wait",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "cert-manager/cert-manager",
        "cloudnative-pg/cloudnative-pg",
        "cloudnative-pg/plugin-barman-cloud"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "OpenBao: the StatefulSet is OnDelete, delete the pod and unseal by hand",
      "matchPackageNames": [
        "openbao",
        "/openbao\\/openbao$/"
      ],
      "groupName": "openbao"
    },
    {
      "description": "Teleport: auth server before the kube agent, one version",
      "matchPackageNames": [
        "teleport-cluster",
        "teleport-kube-agent"
      ],
      "groupName": "teleport"
    },
    {
      "description": "Cilium: the chart in apps/ and the dr.sh bootstrap pin move together",
      "matchPackageNames": [
        "cilium"
      ],
      "groupName": "cilium"
    },
    {
      "description": "ArgoCD: the k3s HelmChart CR pin, retired with the k3s cluster",
      "matchPackageNames": [
        "argo-cd"
      ],
      "groupName": "argo-cd chart"
    },
    {
      "description": "tofu providers: bump the constraint and the lock together, then tofu init -upgrade and plan",
      "matchManagers": [
        "terraform"
      ],
      "rangeStrategy": "bump",
      "groupName": "tofu providers"
    },
    {
      "description": "Talos: one node at a time by hand after the merge",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "groupName": "talos"
    }
  ],
  "customManagers": [
    {
      "description": "Talos pin in talconfig.yaml (talosctl upgrade per node after the merge, docs/versions.md)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^bootstrap/talos/talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "talosVersion: (?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "talosctl image in the etcd backup CronJob, one group with the Talos pin",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/talos/.+\\.yaml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/siderolabs/talosctl:(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Kubernetes pin in talconfig.yaml (talosctl upgrade-k8s after the merge; a minor must be inside the Talos release's supported range)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^bootstrap/talos/talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetesVersion: (?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "local-path-provisioner manifest pinned by release URL",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/local-path/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "rancher/local-path-provisioner/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "rancher/local-path-provisioner",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "DR fallback Cilium in scripts/dr.sh",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/dr\\.sh$/"
      ],
      "matchStrings": [
        "local cil=(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "cilium",
      "registryUrlTemplate": "https://helm.cilium.io",
      "datasourceTemplate": "helm"
    },
    {
      "description": "Operator manifests pinned by release URL (version once in the URL)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/(cert-manager|cnpg-operator)/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>cert-manager/cert-manager|cloudnative-pg/plugin-barman-cloud)/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "CNPG operator manifest, the version appears twice in the URL",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/cnpg-operator/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>cloudnative-pg/cloudnative-pg)/releases/download/(?<currentValue>v[\\d.]+)/cnpg-[\\d.]+\\.yaml"
      ],
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/{{{newValue}}}/cnpg-{{{newVersion}}}.yaml",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "ArgoCD install manifest for the DR bootstrap",
      "customType": "regex",
      "managerFilePatterns": [
        "/^bootstrap/argocd/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "CNPG Cluster imageName",
      "customType": "regex",
      "managerFilePatterns": [
        "/^databases/.+\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
