{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly dependency bumps, never a PR. Patch and minor of images and charts merge straight to main on Monday daytime, one an hour, so each rollout runs alone while someone is around (no CI here, ArgoCD rolls the commit). Everything else waits in the Dependency dashboard issue; ticking its box merges it to main on the next run.",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 10am and before 4pm on monday"
  ],
  "ignoreTests": true,
  "automerge": true,
  "automergeType": "branch",
  "automergeSchedule": [
    "after 10am and before 4pm on monday"
  ],
  "prHourlyLimit": 1,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency dashboard",
  "dependencyDashboardApproval": true,
  "minimumReleaseAge": "7 days",
  "pinDigests": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "docker": {
    "pinDigests": true
  },
  "argocd": {
    "managerFilePatterns": [
      "/^apps/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^infra/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^infra/.+/values.*\\.yaml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/^tofu/.+\\.tf$/"
    ]
  },
  "packageRules": [
    {
      "description": "Noise: git branch sources, apiVersion bumps, the tofu binary constraint, the whoami digest",
      "matchDatasources": [
        "git-tags",
        "kubernetes-api"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "hashicorp/terraform",
        "traefik/whoami"
      ],
      "enabled": false
    },
    {
      "description": "Images: patch, minor and digest bumps merge on schedule. Images are pinned tag@digest, so a floating tag such as python:3.14-alpine only moves through a digest bump",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "matchPackageNames": [
        "!/openbao\\/openbao$/",
        "!ghcr.io/cloudnative-pg/postgresql"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Charts that roll without an operator step: patch and minor merge on schedule",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "loki",
        "vector",
        "kube-prometheus-stack",
        "external-secrets",
        "velero"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Operators from release manifests: patch merges, minor and major wait. CNPG patches roll no Postgres pod (in-place instance manager updates, infra/cnpg-operator/operator-config.yaml); the barman-cloud plugin is left out because a plugin bump changes the sidecar image and rolls every cluster into a switchover",
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchPackageNames": [
        "cert-manager/cert-manager",
        "cloudnative-pg/cloudnative-pg"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "OpenBao: the StatefulSet is OnDelete, delete the pod and unseal by hand",
      "matchPackageNames": [
        "openbao",
        "/openbao\\/openbao$/"
      ],
      "groupName": "openbao"
    },
    {
      "description": "Teleport: auth server before the kube agent, one version",
      "matchPackageNames": [
        "teleport-cluster",
        "teleport-kube-agent"
      ],
      "groupName": "teleport"
    },
    {
      "description": "Cilium: the chart in apps/ and the dr.sh bootstrap pin move together",
      "matchPackageNames": [
        "cilium"
      ],
      "groupName": "cilium"
    },
    {
      "description": "tofu providers: bump the constraint and the lock together, then tofu init -upgrade and plan",
      "matchManagers": [
        "terraform"
      ],
      "rangeStrategy": "bump",
      "groupName": "tofu providers"
    },
    {
      "description": "Talos: one node at a time by hand after the merge",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "groupName": "talos"
    }
  ],
  "customManagers": [
    {
      "description": "Talos pin in talconfig.yaml (talosctl upgrade per node after the merge, docs/operations.md)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^talos/talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "talosVersion: (?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "talosctl image in the etcd backup CronJob, one group with the Talos pin",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/talos/.+\\.yaml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/siderolabs/talosctl:(?<currentValue>v[\\d.]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Kubernetes pin in talconfig.yaml (talosctl upgrade-k8s after the merge; a minor must be inside the Talos release's supported range)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^talos/talconfig\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetesVersion: (?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "DR fallback Cilium in scripts/dr.sh",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/dr\\.sh$/"
      ],
      "matchStrings": [
        "local cil=(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "cilium",
      "registryUrlTemplate": "https://helm.cilium.io",
      "datasourceTemplate": "helm"
    },
    {
      "description": "CNPG Cluster imageName",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/databases/.+\\.yaml$/"
      ],
      "matchStrings": [
        "imageName: (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Upstream manifests pinned to the tag's commit (a raw URL by commit cannot change), version in the trailing comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentDigest>[a-f0-9]{40})/\\S+ # (?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Release asset manifests with their sha256 in the trailing comment; github-watch pages when the served file stops matching it",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[\\d.]+)/[a-z][a-z-]*\\.yaml # sha256:(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "CNPG operator release asset, the version appears twice in the URL",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra/cnpg-operator/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>cloudnative-pg/cloudnative-pg)/releases/download/(?<currentValue>v[\\d.]+)/cnpg-[\\d.]+\\.yaml # sha256:(?<currentDigest>[a-f0-9]{64})"
      ],
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/{{{newValue}}}/cnpg-{{{replace '^v' '' newValue}}}.yaml # sha256:{{{newDigest}}}",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
