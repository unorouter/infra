# Cluster identity backup: etcd snapshot, PKI, k0s.yaml, bootstrap manifests, helm extension
# state, in one archive per controller, copied to the shared backup bucket under k0s/<host>/.
# Runs as root on the controller (k0s backup needs the data dir). Installed by
# bootstrap/k0s/install-backup.sh, credentials in /etc/k0s-backup/env (root only).
[Unit]
Description=k0s cluster state backup to S3
After=network-online.target k0scontroller.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/k0s-backup/env
ExecStart=/bin/bash -c 'set -euo pipefail; d=/var/lib/k0s-backups; mkdir -p $d; find $d -name "k0s_backup_*.tar.gz" -mtime +2 -delete; k0s backup --save-path $d; rclone copy --s3-no-check-bucket --transfers 1 $d ":s3,provider=Other,endpoint=$S3_ENDPOINT,access_key_id=$S3_ACCESS_KEY,secret_access_key=$S3_SECRET_KEY,region=$S3_REGION:$S3_BUCKET/k0s/$(hostname)/"; rclone delete --min-age 30d ":s3,provider=Other,endpoint=$S3_ENDPOINT,access_key_id=$S3_ACCESS_KEY,secret_access_key=$S3_SECRET_KEY,region=$S3_REGION:$S3_BUCKET/k0s/$(hostname)/"'
