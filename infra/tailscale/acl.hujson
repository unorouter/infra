// unorouter admin plane. Daily access is Teleport; this tailnet is the break-glass and node
// plane. Tailnet Lock is on (signers: arch-laptop, netcup-don), new devices need approval or a
// pre-signed auth key. Nodes run Talos: no SSH, the node API (talosctl, 50000) and the kube API
// are the only ports. Root over Tailscale SSH stays for the netcup box, identity re-checked every 12h.
{
	"tagOwners": {
		"tag:node": ["autogroup:admin"],
		"tag:ops":  ["autogroup:admin"],
	},
	"grants": [
		// the operator's devices -> cluster nodes: talosctl + kube api
		{"src": ["2-don@github"], "dst": ["tag:node"], "ip": ["6443", "50000"]},
		// operator -> netcup box
		{"src": ["2-don@github"], "dst": ["tag:ops"], "ip": ["22"]},
		// netcup box may reach the kube api (future automation)
		{"src": ["tag:ops"], "dst": ["tag:node"], "ip": ["6443"]},
		// nodes among themselves (kubeconfig from any node)
		{"src": ["tag:node"], "dst": ["tag:node"], "ip": ["*"]},
	],
	"ssh": [
		{
			"action":      "check",
			"checkPeriod": "12h",
			"src":         ["2-don@github"],
			"dst":         ["tag:ops"],
			"users":       ["root", "don", "autogroup:nonroot"],
		},
	],
}
